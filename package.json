    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.1",
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-anthropic": "^1.9.5",
