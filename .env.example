LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PoC 부품 키 (docs/poc-setup.md)
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=
SONIOX_API_KEY=

# 부품 선택 (비우면 기본값). livekit = LiveKit Inference(별도 키 없음)
# STT_PROVIDER=soniox        # soniox | livekit
# STT_MODEL=stt-rt-v5        # livekit 기본: deepgram/nova-3
# LLM_PROVIDER=anthropic     # anthropic | livekit
# LLM_MODEL=claude-haiku-5-5 # livekit 기본: openai/gpt-6-luna
# LLM_EFFORT=low             # low | medium | high (anthropic 전용)
# LLM_THINKING=off           # off | adaptive (anthropic 전용)
# TTS_PROVIDER=elevenlabs    # elevenlabs | livekit
# TTS_MODEL=eleven_v4_turbo  # livekit 기본: cartesia/sonic-3.6

# 한국어 음성 id. 비우면 공급사 기본 음성(영어)이 나옵니다.
TTS_VOICE=

# 통화 결과 전송 (functions-xtool submitVoiceCallResult). 비우면 보내지 않습니다.
VOICE_RESULT_URL=https://us-central1-xtool-63b29.cloudfunctions.net/submitVoiceCallResult
VOICE_AGENT_SECRET=
